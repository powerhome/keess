{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>powerhome/renovate-config",
    "local>powerhome/renovate-config:ci-kubed-read-token",
    "group:allNonMajor"
  ],
  "packageRules": [
    {
      "description": "Avoid touching image references inside the chart. We should leave the chart logic alone to decide its default versions.",
      "matchFileNames": [
        "chart/values.yaml"
      ],
      "matchPackageNames": [
        "powerhome/keess",
        "powerhome/keess-kubeconfig-reloader"
      ],
      "enabled": false
    },
    {
      "description": "Upgrade Go in one PR: go.mod, setup-go and the golang image move together.",
      "matchDepNames": ["go", "golang"],
      "groupName": "go version",
      "commitMessageTopic": "Go"
    },
    {
      "description": "Bump the go.mod go directive too; by default Renovate leaves it behind.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    }
  ]
}
